<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- F1: same app group as the app — the widget reads the shared
	     SwiftData store (ModelContainerFactory) and selectedTrackID. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.teelog</string>
	</array>
</dict>
</plist>
